# Adresse du projet Supabase (Project Settings > Data API) et clé publishable
# (Project Settings > API Keys, sb_publishable_…). Toutes deux visibles par le navigateur.
# Ne jamais mettre ici la clé secrète sb_secret_….
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_

# Adresse publique du site (sert au retour de la connexion Discord).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret de la tâche quotidienne anti-pause (Vercel l'envoie automatiquement aux crons).
CRON_SECRET=
